CREATE TABLE conversation (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    peer_id TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    last_preview TEXT
);

CREATE TABLE message (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    conversation_id TEXT NOT NULL REFERENCES conversation(id) ON DELETE CASCADE,
    sender TEXT NOT NULL,
    body TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'sent',
    created_at INTEGER NOT NULL
);

CREATE TABLE peer (
    id TEXT NOT NULL PRIMARY KEY,
    display_name TEXT NOT NULL,
    last_seen INTEGER NOT NULL
);

CREATE INDEX idx_message_conversation ON message(conversation_id, created_at);

upsertPeer:
INSERT OR REPLACE INTO peer (id, display_name, last_seen) VALUES (?, ?, ?);

selectPeers:
SELECT * FROM peer ORDER BY last_seen DESC;

CREATE TABLE local_state (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

getLocalState:
SELECT value FROM local_state WHERE key = ?;

setLocalState:
INSERT OR REPLACE INTO local_state (key, value) VALUES (?, ?);

selectConversations:
SELECT * FROM conversation ORDER BY updated_at DESC;

selectConversationById:
SELECT * FROM conversation WHERE id = ?;

insertConversation:
INSERT OR IGNORE INTO conversation (id, title, peer_id, created_at, updated_at, last_preview)
VALUES (?, ?, ?, ?, ?, NULL);

touchConversation:
UPDATE conversation SET updated_at = ?, last_preview = ? WHERE id = ?;

selectMessages:
SELECT * FROM message WHERE conversation_id = ? ORDER BY created_at ASC, id ASC;

insertMessage:
INSERT INTO message (conversation_id, sender, body, status, created_at)
VALUES (?, ?, ?, ?, ?);

selectConversationByPeer:
SELECT * FROM conversation WHERE peer_id = ? LIMIT 1;

setMessageStatus:
UPDATE message SET status = ? WHERE id = ?;